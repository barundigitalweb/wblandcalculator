---
// Header for WBLandCalculator.com
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      {/* Brand Logo */}
      <a href="/" class="flex items-center gap-2.5 group">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-emerald-700 to-teal-600 flex items-center justify-center text-white shadow-md shadow-emerald-700/20 group-hover:scale-105 transition-transform">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
          </svg>
        </div>
        <div>
          <div class="flex items-center gap-1.5">
            <span class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
              WBLand<span class="text-emerald-700">Calculator</span>
            </span>
            <span class="text-[10px] bg-emerald-100 text-emerald-800 font-bold px-1.5 py-0.5 rounded uppercase">
              WB
            </span>
          </div>
          <p class="text-[11px] font-semibold text-slate-400 -mt-1 hidden sm:block">
            পশ্চিমবঙ্গ ভূমি ও আমিন পরিমাপক
          </p>
        </div>
      </a>

      {/* Navigation Links */}
      <nav class="hidden md:flex items-center gap-1 text-sm font-semibold text-slate-600">
        <a href="/" class="px-3 py-2 rounded-lg hover:text-emerald-700 hover:bg-emerald-50 transition">
          কনভার্টার
        </a>
        <a href="/irregular-land-calculator" class="px-3 py-2 rounded-lg hover:text-emerald-700 hover:bg-emerald-50 transition">
          আঁকাবাঁকা জমির মাপ
        </a>
        <a href="/katha-to-sqft-west-bengal" class="px-3 py-2 rounded-lg hover:text-emerald-700 hover:bg-emerald-50 transition">
          কাঠা ↔ স্কয়ার ফিট
        </a>
        <a href="/satak-to-katha-calculator" class="px-3 py-2 rounded-lg hover:text-emerald-700 hover:bg-emerald-50 transition">
          শতক ↔ কাঠা
        </a>
        <a href="/wb-stamp-duty-calculator" class="px-3 py-2 rounded-lg hover:text-emerald-700 hover:bg-emerald-50 transition">
          রেজিস্ট্রি খরচ
        </a>
      </nav>

      {/* Trust pill */}
      <div class="flex items-center gap-3">
        <div class="hidden lg:flex items-center gap-2 bg-slate-100 px-3 py-1.5 rounded-full text-xs font-semibold text-slate-700 border border-slate-200">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>১ কাঠা = ৭২০ Sq Ft</span>
        </div>
        <a
          href="/irregular-land-calculator"
          class="inline-flex items-center gap-1.5 bg-emerald-700 hover:bg-emerald-800 text-white text-xs sm:text-sm font-bold px-3.5 py-2 rounded-xl transition shadow-sm hover:shadow"
        >
          <span>আমিন ক্যালকুলেটর</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </div>
</header>
