---
// Static quick reference conversion table for West Bengal Land Units
---

<div class="bg-white rounded-2xl shadow-lg border border-slate-200/80 p-6 sm:p-8">
  <div class="text-center max-w-2xl mx-auto mb-8">
    <span class="text-xs font-bold text-emerald-700 bg-emerald-50 px-3 py-1 rounded-full uppercase tracking-wider">
      অফিশিয়াল চার্ট
    </span>
    <h3 class="text-2xl sm:text-3xl font-black text-slate-800 mt-2">
      পশ্চিমবঙ্গ ভূমি পরিমাপের প্রামাণ্য একক তালিকা
    </h3>
    <p class="text-slate-500 text-sm mt-1">
      পশ্চিমবঙ্গ ভূমি সংস্কার আইন (WB Land Reforms) অনুযায়ী স্ট্যান্ডার্ড রূপান্তর চার্ট
    </p>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse text-sm">
      <thead>
        <tr class="bg-slate-100 text-slate-700 text-xs uppercase font-extrabold border-b border-slate-200">
          <th class="p-3.5">একক (Unit)</th>
          <th class="p-3.5">বর্গফুট (Sq Ft)</th>
          <th class="p-3.5">শতক / ডেসিমেল</th>
          <th class="p-3.5">কাঠা (Katha)</th>
          <th class="p-3.5">ছটাক (Chatak)</th>
          <th class="p-3.5">বর্গমিটার (Sq Meter)</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 text-slate-700 font-medium">
        <tr class="hover:bg-emerald-50/50 transition">
          <td class="p-3.5 font-bold text-slate-900">১ ছটাক (1 Chatak)</td>
          <td class="p-3.5 font-semibold text-emerald-700">৪৫ sq ft</td>
          <td class="p-3.5">০.১০৩৩ শতক</td>
          <td class="p-3.5">১/১৬ কাঠা (০.০৬২৫)</td>
          <td class="p-3.5">১ ছটাক (২০ গণ্ডা)</td>
          <td class="p-3.5">৪.১৮ বর্গমিটার</td>
        </tr>
        <tr class="hover:bg-emerald-50/50 transition bg-emerald-50/30">
          <td class="p-3.5 font-bold text-slate-900">১ কাঠা (1 Katha) 👑</td>
          <td class="p-3.5 font-black text-emerald-800 text-base">৭২০ sq ft</td>
          <td class="p-3.5 font-bold">১.৬৫২৮ শতক</td>
          <td class="p-3.5 font-bold">১ কাঠা</td>
          <td class="p-3.5">১৬ ছটাক</td>
          <td class="p-3.5">৬৬.৮৯ বর্গমিটার</td>
        </tr>
        <tr class="hover:bg-emerald-50/50 transition">
          <td class="p-3.5 font-bold text-slate-900">১ শতক / ডেসিমেল (1 Satak)</td>
          <td class="p-3.5 font-semibold text-emerald-700">৪৩৫.৬ sq ft</td>
          <td class="p-3.5 font-bold">১ শতক</td>
          <td class="p-3.5">০.৬০৫ কাঠা</td>
          <td class="p-3.5">৯.৬৮ ছটাক</td>
          <td class="p-3.5">৪০.৪৭ বর্গমিটার</td>
        </tr>
        <tr class="hover:bg-emerald-50/50 transition bg-emerald-50/30">
          <td class="p-3.5 font-bold text-slate-900">১ বিঘা (1 Bigha)</td>
          <td class="p-3.5 font-black text-emerald-800 text-base">১৪,৪০০ sq ft</td>
          <td class="p-3.5 font-bold">৩৩.০৫৮ শতক</td>
          <td class="p-3.5 font-bold">২০ কাঠা</td>
          <td class="p-3.5">৩২০ ছটাক</td>
          <td class="p-3.5">১,৩৩৭.৮ বর্গমিটার</td>
        </tr>
        <tr class="hover:bg-emerald-50/50 transition">
          <td class="p-3.5 font-bold text-slate-900">১ একর (1 Acre)</td>
          <td class="p-3.5 font-semibold text-emerald-700">৪৩,৫৬০ sq ft</td>
          <td class="p-3.5 font-bold">১০০ শতক</td>
          <td class="p-3.5">৬০.৫ কাঠা (৩ বিঘা ৮ ছটাক)</td>
          <td class="p-3.5">৯৬৮ ছটাক</td>
          <td class="p-3.5">৪,০৪৬.৮৬ বর্গমিটার</td>
        </tr>
        <tr class="hover:bg-emerald-50/50 transition">
          <td class="p-3.5 font-bold text-slate-900">১ গণ্ডা (1 Ganda)</td>
          <td class="p-3.5 font-semibold text-emerald-700">২.২৫ sq ft</td>
          <td class="p-3.5">০.০০৫১৭ শতক</td>
          <td class="p-3.5">-</td>
          <td class="p-3.5">১/২০ ছটাক</td>
          <td class="p-3.5">০.২০৯ বর্গমিটার</td>
        </tr>
        <tr class="hover:bg-emerald-50/50 transition">
          <td class="p-3.5 font-bold text-slate-900">১ কড়া (1 Kora)</td>
          <td class="p-3.5 font-semibold text-emerald-700">০.৫৬২৫ sq ft</td>
          <td class="p-3.5">-</td>
          <td class="p-3.5">-</td>
          <td class="p-3.5">১/৮০ ছটাক</td>
          <td class="p-3.5">০.০৫২২ বর্গমিটার</td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
