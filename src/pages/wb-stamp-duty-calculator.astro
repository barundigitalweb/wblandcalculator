---
import Layout from '../layouts/Layout.astro';
import StampDutyCalculator from '../components/StampDutyCalculator';
import FaqSection from '../components/FaqSection.astro';
---

<Layout
  title="West Bengal Stamp Duty & Registration Fees Calculator | দলিল রেজিস্ট্রি খরচ"
  description="পশ্চিমবঙ্গে ফ্ল্যাট ও জমি রেজিস্ট্রি খরচের অনলাইন ক্যালকুলেটর। পঞ্চায়েত ও পুরসভা এলাকা অনুযায়ী ৫%-৬% স্ট্যাম্প ডিউটি, ১% রেজিস্ট্রেশন ফি এবং পারিবারিক দানপত্রের বিশেষ ছাড়ের হিসাব।"
  keywords="west bengal stamp duty calculator, wb property registration charges, flat registry charges in kolkata, west bengal land registration fee calculator"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-10">
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 bg-emerald-100 text-emerald-800 text-xs font-bold px-3 py-1 rounded-full">
        পশ্চিমবঙ্গ আইজিআর সার্কুলার অনুযায়ী
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight">
        পশ্চিমবঙ্গ <span class="text-emerald-700">রেজিস্ট্রি খরচ</span> ও স্ট্যাম্প ডিউটি
      </h1>
      <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
        জমি বা ফ্ল্যাটের আনুমানিক বাজারমূল্য লিখুন—মুহূর্তেই জেনে নিন কত টাকা স্ট্যাম্প ডিউটি ও সরকারি ফি লাগবে।
      </p>
    </div>

    <StampDutyCalculator client:idle />

    <section class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200/80 shadow-md space-y-6">
      <h2 class="text-2xl font-black text-slate-800">
        পশ্চিমবঙ্গে সম্পত্তি রেজিস্ট্রি ফির নিয়মাবলী (West Bengal Registration Rules)
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm text-slate-700">
        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-2">
          <h3 class="font-bold text-slate-900">১. গ্রাম পঞ্চায়েত এলাকা (Panchayat Areas):</h3>
          <p>
            বাজারমূল্য ১ কোটি টাকা পর্যন্ত হলে <strong>৫% স্ট্যাম্প ডিউটি</strong> এবং ১ কোটির বেশি হলে <strong>৬% স্ট্যাম্প ডিউটি</strong> প্রযোজ্য। রেজিস্ট্রেশন ফি সর্বদাই <strong>১%</strong>।
          </p>
        </div>

        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-2">
          <h3 class="font-bold text-slate-900">২. পৌরসভা ও কর্পোরেশন এলাকা (Urban / Municipality):</h3>
          <p>
            কলকাতা কর্পোরেশন (KMC), হাওড়া (HMC), বিধাননগর, শিলিগুড়ি বা অন্যান্য পুরসভা এলাকায় বাজারমূল্য ১ কোটি পর্যন্ত <strong>৬% স্ট্যাম্প ডিউটি</strong> এবং ১ কোটির বেশি হলে <strong>৭% স্ট্যাম্প ডিউটি</strong> প্রযোজ্য। রেজিস্ট্রেশন ফি <strong>১%</strong>।
          </p>
        </div>
      </div>

      <div class="p-4 bg-emerald-50 rounded-xl border border-emerald-200 text-sm text-emerald-950 space-y-2">
        <div class="font-bold flex items-center gap-2 text-emerald-900">
          <span>📜 পারিবারিক দানপত্র দলিলের বিশেষ ছাড় (Family Gift Deed Concession):</span>
        </div>
        <p>
          পশ্চিমবঙ্গ সরকারের অর্থ দপ্তর ও রেজিস্ট্রেশন নিয়মাবলী (wbregistration.gov.in) অনুযায়ী, যদি কোনো সম্পত্তি পরিবারের নিকট রক্তের সম্পর্কের সদস্যদের (বাবা-মা, সন্তান, স্বামী-স্ত্রী, ভাই-বোন) মধ্যে হেবা বা দানপত্র (Gift Deed) করা হয়, তবে সাধারণ ৫%-৬% এর পরিবর্তে মাত্র <strong>০.৫% কনসেশনাল স্ট্যাম্প ডিউটি</strong> ও ১% রেজিস্ট্রেশন ফি প্রযোজ্য হয়।
        </p>
      </div>

      <div class="p-4 bg-amber-50 rounded-xl border border-amber-200 text-xs text-amber-950">
        <strong>💡 আইনি তথ্য (Fact-Check):</strong> পশ্চিমবঙ্গে সাধারণ বিক্রয় দলিলের (Sale Deed) ক্ষেত্রে পুরুষ ও মহিলা উভয় ক্রেতার জন্যই স্ট্যাম্প ডিউটির হার সমান (আলাদা কোনো মহিলা ছাড় নেই)। ইন্টারনেটে বিভিন্ন জাতীয় পোর্টালে অন্য রাজ্যের নিয়ম ভুল করে পশ্চিমবঙ্গের নামে প্রচার করা হয়। wblandcalculator.com পশ্চিমবঙ্গ সরকারের সর্বশেষ গেজেট বিজ্ঞপ্তি অনুযায়ী পরিচালিত।
      </div>
    </section>

    <FaqSection />
  </div>
</Layout>
