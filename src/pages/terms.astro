---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="ব্যবহারের শর্তাবলী (Terms of Service) | WBLandCalculator.com"
  description="WBLandCalculator.com ব্যবহারের নিয়ম ও শর্তাবলী।"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-10">
    <div class="text-center space-y-3">
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
        ব্যবহারের শর্তাবলী (Terms of Service)
      </h1>
      <p class="text-slate-500 text-sm">কার্যকরী তারিখ: নভেম্বর ২০২৬</p>
    </div>

    <div class="bg-white rounded-2xl p-6 sm:p-10 border border-slate-200/80 shadow-md space-y-6 text-slate-700 text-sm leading-relaxed">
      <section class="space-y-2">
        <h2 class="text-lg font-bold text-slate-900">১. শর্তাবলীর স্বীকৃতি</h2>
        <p>
          WBLandCalculator.com ওয়েবসাইটটি ব্যবহার করার মাধ্যমে আপনি এই ব্যবহারের শর্তাবলী মেনে নিতে সম্মত হচ্ছেন। আপনি যদি এই শর্তাবলীতে একমত না হন, তবে অনুগ্রহ করে আমাদের পরিষেবা ব্যবহার থেকে বিরত থাকুন।
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-lg font-bold text-slate-900">২. সেবার প্রকৃতি</h2>
        <p>
          আমাদের ওয়েবসাইটটি শুধুমাত্র শিক্ষামূলক, তথ্যবহুল এবং গাণিতিক হিসাব অনুমানের সুবিধার্থে তৈরি করা হয়েছে। এটি কোনো সার্টিফায়েড সরকারি জরিপ বা আইনি দলিল প্রদানের বিকল্প নয়।
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-lg font-bold text-slate-900">৩. বুদ্ধিবৃত্তিক সম্পত্তি</h2>
        <p>
          এই ওয়েবসাইটের ইন্টারফেস, কোডিং, ডিজাইন এবং অ্যালগরিদম WBLandCalculator.com-এর মেধা সম্পদ। বিনা অনুমতিতে এর কোড বা বিষয়বস্তু কপি করে অনুরূপ সাইট তৈরি করা নিষিদ্ধ।
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-lg font-bold text-slate-900">৪. দায়বদ্ধতার সীমাবদ্ধতা</h2>
        <p>
          ওয়েবসাইটের ক্যালকুলেটরের ফলাফল ব্যবহার করে কৃত কোনো বাণিজ্যিক বা ব্যক্তিগত লেনদেনের কোনো আর্থিক বা আইনি ক্ষতির জন্য WBLandCalculator.com বা এর পরিচালনাকারী কোনোভাবেই দায়ী থাকবে না।
        </p>
      </section>
    </div>
  </div>
</Layout>
