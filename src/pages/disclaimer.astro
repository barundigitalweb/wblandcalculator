---
import Layout from '../layouts/Layout.astro';
import { AlertCircle } from 'lucide-react';
---

<Layout
  title="অস্বীকৃতি (Disclaimer) | WBLandCalculator.com"
  description="WBLandCalculator.com-এর আইনি ও সরকারি অস্বীকৃতি বিবৃতি।"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-10">
    <div class="text-center space-y-3">
      <div class="inline-flex p-3 bg-amber-100 text-amber-800 rounded-2xl mb-1">
        <AlertCircle class="w-8 h-8" />
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
        আইনি অস্বীকৃতি (Legal Disclaimer)
      </h1>
      <p class="text-slate-500 text-sm">গুরুত্বপূর্ণ আইনি সতর্কতা ও তথ্য</p>
    </div>

    <div class="bg-white rounded-2xl p-6 sm:p-10 border border-slate-200/80 shadow-md space-y-8 text-slate-700 text-sm leading-relaxed">
      <div class="p-4 bg-amber-50 border-l-4 border-amber-500 rounded-r-xl text-amber-950 font-medium">
        <strong>সরাসরি সরকারি সম্পর্কহীনতা:</strong> WBLandCalculator.com পশ্চিমবঙ্গ সরকার, ভূমি ও ভূমি সংস্কার দপ্তর (Directorate of Land Records & Surveys), Banglarbhumi পোর্টাল বা কোনো সরকারি সাব-রেজিস্ট্রার অফিসের সাথে প্রত্যক্ষ বা পরোক্ষভাবে যুক্ত নয়।
      </div>

      <section class="space-y-3">
        <h2 class="text-lg font-bold text-slate-900">১. শিক্ষামূলক ও আনুমানিক হিসাব</h2>
        <p>
          এই ওয়েবসাইটের সমস্ত ক্যালকুলেটর (যেমন: শতক-কাঠা কনভার্টার, হিরন ফর্মুলা বিষমবাহু পরিমাপক, দলিল ভাঙানি ও স্ট্যাম্প ডিউটি এস্টিমেটর) শুধুমাত্র গাণিতিক গণনা এবং প্রাথমিক অনুমানের উদ্দেশ্যে প্রোগ্রাম করা হয়েছে।
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-lg font-bold text-slate-900">২. সার্টিফায়েড আমিনের ভূমিকা</h2>
        <p>
          জমির সঠিক সীমানা নির্ধারণ, রেকর্ড অফ রাইটস (ROR / পর্চা), মিউটেশন এবং রেজিস্ট্রি দলিলের চূড়ান্ত বৈধতার জন্য সর্বদা সরকার অনুমোদিত ও লাইসেন্সপ্রাপ্ত আমিন (Land Surveyor) দ্বারা ফিজিক্যাল পরিমাপ এবং অভিজ্ঞ অ্যাডভোকেট/দলিল লেখকের পরামর্শ নেওয়া আবশ্যক।
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-lg font-bold text-slate-900">৩. সার্কেল রেট ও সরকারি ফি পরিবর্তন</h2>
        <p>
          স্ট্যাম্প ডিউটি ও রেজিস্ট্রেশন ফি রাজ্য সরকারের অর্থ দপ্তর ও আইজিআর সার্কুলার দ্বারা সময় সময় পরিবর্তিত হতে পারে। পৌরসভা বা মৌজা ভিত্তিক সার্কেল রেটের সঠিক তথ্যের জন্য সংশ্লিষ্ট সাব-রেজিস্ট্রি অফিসে খোঁজ নেওয়ার অনুরোধ করা হচ্ছে।
        </p>
      </section>

      <div class="pt-4 border-t text-xs text-slate-500">
        অস্বীকৃতি বা সাইটের তথ্য সম্পর্কিত যেকোনো ব্যাখ্যার জন্য যোগাযোগ: <a href="mailto:contact@wblandcalculator.com" class="text-emerald-700 font-semibold underline">contact@wblandcalculator.com</a>
      </div>
    </div>
  </div>
</Layout>
