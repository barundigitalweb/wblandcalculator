---
import Layout from '../layouts/Layout.astro';
import { Mail, MessageSquare, Clock } from 'lucide-react';
---

<Layout
  title="যোগাযোগ (Contact Us) | WBLandCalculator.com"
  description="WBLandCalculator.com টিমের সাথে যোগাযোগ করুন। কোনো ফিডব্যাক, বাগ রিপোর্ট বা পরামর্শের জন্য আমাদের লিখুন।"
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-10">
    <div class="text-center space-y-3">
      <span class="text-xs font-bold text-emerald-700 bg-emerald-50 px-3 py-1 rounded-full uppercase">
        ফিডব্যাক ও সহায়তা
      </span>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
        যোগাযোগ করুন (Contact Us)
      </h1>
      <p class="text-slate-600 text-sm sm:text-base">
        আমাদের ক্যালকুলেটরে কোনো নতুন ফিচার যুক্ত করার পরামর্শ বা ভুল সংশোধনের তথ্য থাকলে আমাদের জানান।
      </p>
    </div>

    <div class="bg-white rounded-2xl p-6 sm:p-10 border border-slate-200/80 shadow-md space-y-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 flex items-center gap-3">
          <div class="p-2.5 bg-emerald-100 text-emerald-800 rounded-lg">
            <Mail class="w-5 h-5" />
          </div>
          <div>
            <span class="text-xs text-slate-500 font-medium block">সাপোর্ট ইমেইল</span>
            <span class="text-sm font-bold text-slate-800">support@wblandcalculator.com</span>
          </div>
        </div>

        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 flex items-center gap-3">
          <div class="p-2.5 bg-emerald-100 text-emerald-800 rounded-lg">
            <Clock class="w-5 h-5" />
          </div>
          <div>
            <span class="text-xs text-slate-500 font-medium block">উত্তর দেওয়ার সময়সীমা</span>
            <span class="text-sm font-bold text-slate-800">২৪ থেকে ৪৮ ঘণ্টার মধ্যে</span>
          </div>
        </div>
      </div>

      <form class="space-y-4" onsubmit="event.preventDefault(); alert('ধন্যবাদ! আপনার বার্তাটি গৃহীত হয়েছে।');">
        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase mb-1">আপনার নাম (Your Name)</label>
          <input
            type="text"
            required
            placeholder="আপনার পূর্ণ নাম..."
            class="w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-2.5 text-sm focus:border-emerald-600 outline-none"
          />
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase mb-1">ইমেইল ঠিকানা (Email Address)</label>
          <input
            type="email"
            required
            placeholder="name@example.com"
            class="w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-2.5 text-sm focus:border-emerald-600 outline-none"
          />
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-600 uppercase mb-1">বার্তা বা পরামর্শ (Message)</label>
          <textarea
            rows="4"
            required
            placeholder="আপনার বার্তা বা পরামর্শ এখানে বিস্তারিত লিখুন..."
            class="w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-2.5 text-sm focus:border-emerald-600 outline-none"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full bg-emerald-700 hover:bg-emerald-800 text-white font-bold py-3 rounded-xl transition shadow-md"
        >
          বার্তা পাঠান (Send Message)
        </button>
      </form>
    </div>
  </div>
</Layout>
